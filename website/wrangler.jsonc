{
  "$schema": "https://unpkg.com/wrangler@4.144.0/config-schema.json",
  "name": "buddymac-website",
  "account_id": "157a8b025a13404b16f11ad7078e53f1",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "mac.buddytools.org", "custom_domain": true },
    { "pattern": "mac.buddytools.org/*", "zone_name": "buddytools.org" }
  ]
}
